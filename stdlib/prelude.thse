-- Theseus standard prelude: implicit types, isos and prims available in every
-- program. A program that declares one of these names itself keeps its own
-- declaration and the prelude copy is dropped.
--
-- Do not declare a prelude `prim` at a type variable (`a * a`): that passes
-- `check` but does not elaborate (a known gap, ADR-0047).

type Bit = O | I
type Nat = Zero | Succ Nat

iso notb : Bit <-> Bit
| O <-> I
| I <-> O

iso swapBit : Bit * Bit <-> Bit * Bit
| (a, b) <-> (b, a)

iso cnot : Bit * Bit <-> Bit * Bit
| (O, b) <-> (O, b)
| (I, O) <-> (I, I)
| (I, I) <-> (I, O)

iso toffoli : (Bit, Bit, Bit) <-> (Bit, Bit, Bit)
| (O, b, t) <-> (O, b, t)
| (I, O, t) <-> (I, O, t)
| (I, I, O) <-> (I, I, I)
| (I, I, I) <-> (I, I, O)

-- Built-in primitives (ADR-0047). The key is width-parametric over W1..W8, but
-- a `prim` declaration fixes one type, so the prelude name is fixed at W8. A
-- program at another width declares its own, e.g.
--   prim add_into : W4 * W4 <-> W4 * W4 = "theseus.arith.add_into"
-- (which replaces this one) or the same line under a different name.
prim add_into : W8 * W8 <-> W8 * W8 = "theseus.arith.add_into"
