+    // ── T-loops slice-1b POC: gcd2_hist_step (2-bit subtractive GCD) ───
+    // Name-gate + FULL-DOMAIN semantic check against the pinned v4 byte
+    // rule (gcd2_hist_bytes) — the same architecture as mde_spill_walk.
+    // RECOGNITION is complete and sound; EMISSION is blocked on the
+    // WCET-256 wall: k_exact = 5 for this carrier ⇒ body ≤ 40 instrs
+    // (4 + 5·(len+10) ≤ 256), while the minimal correct walk needs the
+    // entry/exit involution + gated normalize-subtract + a ≥6-way
+    // cross-payload junk-relocation arm, each predicate costing a
+    // multi-instruction mask-alignment gadget (no spare registers: the
+    // 4 carrier leaves fill the register budget; aux regs 4..7 are live
+    // loop machinery) — an estimated 60+ instructions. Reject-don't-
+    // corrupt: a verified table gets a precise Deferred; a mismatching
+    // table falls through to UnrecognizedPrim.
+    if def.forward_name == "gcd2_hist_step" && n_in == 4 && n_out == 4 {
+        let vals = enumerate_values(&def.input_ty);
+        if check_pattern_kleaf(&def.forward, &vals, &def.input_ty, &def.output_ty, 4, gcd2_hist_bytes)
+        {
+            return Err(CompileError::Deferred(
+                "gcd2_hist_step: table verified against the pinned v4 GCD byte rule, \
+                 but no TISC-1 emission fits the Trace WCET budget (k_exact=5 ⇒ body \
+                 ≤ 40 instrs; minimal gated walk ≈ 60+). Needs widen-PC or a \
+                 conditional-arithmetic ISA op (T-loops slice-1b POC)"
+                    .into(),
+            ));
+        }
+    }
+
     Err(CompileError::UnrecognizedPrim(format!(
         "prim '{}' not recognized as a TISC-1 pattern",
         def.forward_name
     )))
 }
 
+/// Byte semantics of the pinned 2-bit GCD-with-history step ("v4" rule,
+/// T-loops slice-1b POC). Carrier bytes: [tag, a, b, h]; tag 1 = Right
+/// (io arm), 0 = Left (u arm); a,b ∈ 0..4, h ∈ 0..8.
+///
+/// TOTAL, canonically closed, injective on all 256 canonical states;
+/// every Right state terminates within 4 applications (k_exact = 5).
+/// Meaningful arms: entry (1,p,0)→(0,p,1); gated normalize-subtract
+/// with the branch bit shifted into the history; h-preserving exits at
+/// the (1,1) fixpoint; zE (zero/equal) inputs bounce back unchanged.
+/// Must match any future emitted instruction walk EXACTLY (byte-wide).
+#[doc(hidden)]
+pub fn gcd2_hist_bytes(bb: &mut [u8]) {
+    let (t, a, b, h) = (bb[0], bb[1], bb[2], bb[3]);
+    let d = a != b && a != 0 && b != 0;
+    let out: [u8; 4] = if t == 1 {
+        if h == 0 {
+            [0, a, b, 1] // A1: entry, sentinel h=1
+        } else if a == 1 && b == 1 && h >= 2 {
+            // A2 scatter: vacate (1,(1,1),{2..7}) into the freed (1,D,0)
+            // slots so the h-preserving (1,1)-exits fit (slot conservation).
+            let p: [(u8, u8); 6] = [(1, 2), (2, 1), (1, 3), (3, 1), (2, 3), (3, 2)];
+            let (x, y) = p[(h - 2) as usize];
+            [1, x, y, 0]
+        } else {
+            [t, a, b, h] // A2: junk entries park (Right, terminates)
+        }
+    } else if !d && h == 1 {
+        [1, a, b, 0] // A3: zE exit (inverse of A1 on zero/equal payloads)
+    } else if a == 1 && b == 1 && h >= 2 {
+        [1, a, b, h] // A3: real gcd exit, h-preserving
+    } else if d && (1..=3).contains(&h) {
+        // A4: normalize-subtract; branch bit s joins the history shift.
+        let (x, y, s) = if a > b { (a - b, b, 0) } else { (b - a, a, 1) };
+        [0, x, y, 2 * h + s]
+    } else if ((a, b) == (2, 1) || (a, b) == (1, 2)) && h >= 4 {
+        // Y-remap: these 8 junk Left states' id-slots are A4 images;
+        // relocate to the free (0,{(1,3),(3,1),(2,3),(3,2)},{2,3}) slots.
+        let (x, y) = if (a, b) == (2, 1) {
+            if h < 6 { (1, 3) } else { (3, 1) }
+        } else if h < 6 {
+            (2, 3)
+        } else {
+            (3, 2)
+        };
+        [0, x, y, 2 + (h & 1)]
+    } else {
+        [t, a, b, h] // id (junk)
+    };
+    bb[..4].copy_from_slice(&out);
+}
