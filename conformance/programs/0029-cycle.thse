-- Conformance P0029 (dialect: synthesizable)
-- A 3-cycle on a product, fixing one point: not a controlled operation on
-- either bit and not a product of two one-bit maps.
type Bit = O | I

iso cyc : (Bit, Bit) <-> (Bit, Bit)
| (O, O) <-> (O, I)
| (O, I) <-> (I, O)
| (I, O) <-> (O, O)
| (I, I) <-> (I, I)
