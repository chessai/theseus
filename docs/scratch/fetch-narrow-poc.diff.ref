+/// bit (free: pred is 3W, chain intermediates top out at 4W−2).
+const FETCH_HZ_WIRE: usize = 4 * W - 1;
+
+/// ceil(log2(n)): smallest k with n <= 2^k. ceil_log2(1) = 0.
+fn ceil_log2(n: usize) -> usize {
+    assert!(n >= 1);
+    (usize::BITS - (n - 1).leading_zeros()) as usize
+}
+
+/// A = number of PC address bits the fetch predicate must compare so
+/// that every PC value reachable during a `budget`-step run (live
+/// entries 0..N−1, the park zone, and forward skips) is uniquely
+/// identified by its low A bits.
+///
+/// Soundness: PC starts at 0 and advances by BR+1 per step; over
+/// `budget` steps the total advance is ≤ budget + s_max, so every PC
+/// value *presented to a fetch* (i.e. before steps 1..budget) is
+/// ≤ budget − 1 + s_max < budget + s_max. Hence A = ⌈log₂(B + S_max)⌉
+/// covers them all, and — being all distinct values < 2^A — no two
+/// reachable PCs collide on the low A bits (no park/live aliasing).
+/// Clamped to [1, W].
+pub fn fetch_addr_bits(budget: usize, s_max: usize) -> usize {
+    ceil_log2((budget + s_max).max(2)).clamp(1, W)
+}
+
+/// Compute the predicate `PC == addr` (an A-bit compare) into s1 bit 0.
+///
+/// For `a == W` this is the original full-width 8-literal AND: NOTs on
+/// the zero literals, W−1-Toffoli chain through s1 bits 1..=W−2, NOTs
+/// undone. For `a < W` the chain ANDs the **low `a` PC literals plus
+/// the shared high-zero flag** (see [`high_zero`]) — `a` Toffolis — so
+/// the predicate is semantically IDENTICAL to the full `PC == addr`
+/// compare for every one of the 2^W PC values (reject-don't-corrupt is
+/// preserved), while the per-entry cost drops from 2(W−1) to 2a
+/// Toffolis. `Iso::sym` uncomputes it.
+fn pc_pred_a(addr: usize, a: usize) -> Iso {
+    assert!((1..=W).contains(&a), "address-compare width a={a} out of range");
+    assert!(addr < (1 << a), "ROM address {addr} not representable in {a} bits");
+    let nots: Vec<Iso> = (0..a)
         .filter(|i| (addr >> i) & 1 == 0)
         .map(|i| at_wire(FETCH_N, i, not_iso()))
         .collect();
     let mut gates = nots.clone();
     let mut acc = 0usize;
-    for j in 1..W {
-        let tgt = if j == W - 1 {
-            FETCH_PRED_WIRE
-        } else {
-            FETCH_CHAIN0 + (j - 1)
-        };
-        gates.push(gate_at(FETCH_N, &[acc, j, tgt], toffoli_prim()));
-        acc = tgt;
+    if a == W {
+        // Original full-W chain: W literals, W−1 Toffolis.
+        for j in 1..W {
+            let tgt = if j == W - 1 {
+                FETCH_PRED_WIRE
+            } else {
+                FETCH_CHAIN0 + (j - 1)
+            };
+            gates.push(gate_at(FETCH_N, &[acc, j, tgt], toffoli_prim()));
+            acc = tgt;
+        }
+    } else {
+        // Narrow chain: a low literals + the shared high-zero flag
+        // (FETCH_HZ_WIRE), a Toffolis total.
+        for j in 1..a {
+            let tgt = FETCH_CHAIN0 + (j - 1);
+            gates.push(gate_at(FETCH_N, &[acc, j, tgt], toffoli_prim()));
+            acc = tgt;
+        }
+        gates.push(gate_at(FETCH_N, &[acc, FETCH_HZ_WIRE, FETCH_PRED_WIRE], toffoli_prim()));
+    }
+    gates.extend(nots);
+    on_fields(&[PC_FIELD, IR_LO_FIELD, IR_HI_FIELD, AUX_PRED_FIELD], gates)
+}
+
+/// Compute the shared "high W−a PC bits are all zero" flag into
+/// FETCH_HZ_WIRE (computed ONCE per fetch, not per entry). Bennett
+/// style: NOTs on the high bits, Toffoli chain into the flag, chain
+/// intermediates uncomputed by replaying all-but-the-last gate in
+/// reverse, NOTs undone. `Iso::sym` uncomputes the flag.
+fn high_zero(a: usize) -> Iso {
+    let h = W - a;
+    assert!(h >= 1);
+    let nots: Vec<Iso> = (a..W).map(|i| at_wire(FETCH_N, i, not_iso())).collect();
+    let mut gates = nots.clone();
+    if h == 1 {
+        // Single literal: flag ^= ¬PC[W−1] via CNOT under the NOT.
+        gates.push(gate_at(FETCH_N, &[a, FETCH_HZ_WIRE], cnot_prim()));
+    } else {
+        let mut chain: Vec<Iso> = Vec::new();
+        let mut acc = a;
+        for (idx, j) in (a + 1..W).enumerate() {
+            let tgt = if j == W - 1 {
+                FETCH_HZ_WIRE
+            } else {
+                FETCH_CHAIN0 + idx
+            };
+            chain.push(gate_at(FETCH_N, &[acc, j, tgt], toffoli_prim()));
+            acc = tgt;
+        }
+        gates.extend(chain.iter().cloned());
+        // Uncompute the h−2 chain intermediates (self-inverse Toffolis,
+        // controls unchanged), leaving only the flag set.
+        gates.extend(chain[..chain.len() - 1].iter().rev().cloned());
+    }
+    gates.extend(nots);
+    on_fields(&[PC_FIELD, IR_LO_FIELD, IR_HI_FIELD, AUX_PRED_FIELD], gates)
+}
+
+/// UNGUARDED narrow predicate: AND of the low `a` PC literals ONLY
+/// (a−1 Toffolis; no high-zero input). Correct ONLY under the invariant
+/// PC < 2^a for every fetched PC — used by the POC teeth test to show
+/// what an under-derived A corrupts. NOT the recommended ship variant.
+fn pc_pred_low(addr: usize, a: usize) -> Iso {
+    assert!((1..=W).contains(&a));
+    assert!(addr < (1 << a));
+    let nots: Vec<Iso> = (0..a)
+        .filter(|i| (addr >> i) & 1 == 0)
+        .map(|i| at_wire(FETCH_N, i, not_iso()))
+        .collect();
+    let mut gates = nots.clone();
+    if a == 1 {
+        gates.push(gate_at(FETCH_N, &[0, FETCH_PRED_WIRE], cnot_prim()));
+    } else {
+        let mut acc = 0usize;
+        for j in 1..a {
+            let tgt = if j == a - 1 {
+                FETCH_PRED_WIRE
+            } else {
+                FETCH_CHAIN0 + (j - 1)
+            };
+            gates.push(gate_at(FETCH_N, &[acc, j, tgt], toffoli_prim()));
+            acc = tgt;
+        }
     }
     gates.extend(nots);
     on_fields(&[PC_FIELD, IR_LO_FIELD, IR_HI_FIELD, AUX_PRED_FIELD], gates)
 }
 
