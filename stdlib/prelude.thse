-- Theseus standard prelude: implicit types and isos available in every program.

type Bit = O | I
type Nat = Zero | Succ Nat

iso notb : Bit <-> Bit
| O <-> I
| I <-> O

iso swapBit : Bit * Bit <-> Bit * Bit
| (a, b) <-> (b, a)

iso cnot : Bit * Bit <-> Bit * Bit
| (O, b) <-> (O, b)
| (I, O) <-> (I, I)
| (I, I) <-> (I, O)

iso toffoli : (Bit, Bit, Bit) <-> (Bit, Bit, Bit)
| (O, b, t) <-> (O, b, t)
| (I, O, t) <-> (I, O, t)
| (I, I, O) <-> (I, I, I)
| (I, I, I) <-> (I, I, O)
