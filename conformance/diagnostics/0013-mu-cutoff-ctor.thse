-- D0013: a constructor past the unroll cutoff of a recursive type (ADR-0035).
-- `Nat@1` has the single inhabitant `Zero`; under `Succ` its payload has the
-- empty core type `0`, so `Succ Zero` matches no value. Both columns are
-- covered -- yet clause 2 sends `Zero` to `Succ Zero`, outside the type.
type Nat = Zero | Succ Nat

iso g : Nat@1 <-> Nat@1
| Succ Zero <-> Zero
| Zero <-> Succ Zero
