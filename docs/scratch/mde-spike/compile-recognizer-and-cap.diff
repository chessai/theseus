+/// SPIKE M-D.e: byte semantics of the pinned 13-instruction walk.
+/// Must match the emitted instruction sequence EXACTLY (byte-wide).
+pub fn mde_walk_bytes(b: &mut [u8]) {
+    b[0] ^= b[1];
+    b[0] ^= 1;
+    b[1] ^= 1;
+    b[2] ^= b[3];
+    b[3] ^= b[4];
+    b[0] ^= 1;
+    if b[0] & 1 == 1 {
+        b.swap(1, 2);
+        b.swap(2, 3);
+        b.swap(3, 4);
+    }
+    b[0] ^= 1;
+    b[3] ^= b[4];
+    b[2] ^= b[3];
+    b[1] ^= b[2];
+}
+
+/// SPIKE M-D.e: k-leaf generalization of `check_pattern_2leaf` — verify a
+/// prim's clause table matches a pinned byte-level map over k leaves.
+fn check_pattern_kleaf(
+    forward: &std::collections::BTreeMap<Value, Value>,
+    vals: &[Value],
+    in_ty: &Type,
+    out_ty: &Type,
+    k: usize,
+    f: impl Fn(&mut [u8]),
+) -> bool {
+    for v in vals {
+        let mut bytes = value_to_leaf_bytes(v, in_ty);
+        if bytes.len() != k {
+            return false;
+        }
+        f(&mut bytes);
+        let Some(out) = forward.get(v) else {
+            return false;
+        };
+        if value_to_leaf_bytes(out, out_ty) != bytes {
+            return false;
+        }
+    }
+    true
+}
